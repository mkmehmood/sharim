      "url": "./?action=production",
      "icons": [{ "src": "192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Calculator",
      "short_name": "Calc",
      "description": "Open sales calculator",
      "url": "./?action=calc",
      "icons": [{ "src": "192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
